# ========================
# DATABASE CONFIGURATION
# ========================
DATABASE_NAME=job_portal
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# ========================
# FLASK CONFIGURATION
# ========================
FLASK_APP=run.py:app
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-random-secret-key
DEBUG=True

# ========================
# FILE UPLOAD SETTINGS
# ========================
UPLOAD_FOLDER=uploads
CANDIDATE_UPLOADS=uploads/cvs
JOBGIVER_UPLOADS=uploads/jobs
MAX_CONTENT_LENGTH=16777216

# ========================
# APPLICATION INFO
# ========================
APP_NAME=Job Sansar
APP_VERSION=1.0